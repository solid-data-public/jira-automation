# Solid MCP auth (required for mcp_solid_text2sql in CI)
# Exchange at https://backend.production.soliddata.io/api/v1/auth/exchange_user_access_key
# Use scripts/exchange_solid_token.py to get the token locally
SOLIDDATA_MANAGEMENT_KEY=your_management_key

# Snowflake connection (required for scripts/query_snowflake.py)
# Copy to .env and fill in real values

SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_DATABASE=SUN_SPECTRA
SNOWFLAKE_SCHEMA=

# JIRA (required for scripts/post_to_jira.py and GitHub Actions)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your_jira_api_token
